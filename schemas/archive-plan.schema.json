{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/archive-plan-v1.json",
  "title": "Harness archive plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "created_at", "workspace_root", "workspace_fingerprint", "archive_id", "archive_root", "owner", "reason", "authorization_required", "items", "exclusions", "rollback", "restore"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^plan-[a-f0-9]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "workspace_root": {"type": "string", "minLength": 1},
    "workspace_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "archive_id": {"type": "string", "pattern": "^arc-[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,47}$"},
    "archive_root": {"type": "string", "minLength": 9},
    "owner": {"type": "string", "minLength": 2, "maxLength": 200},
    "reason": {"type": "string", "minLength": 8, "maxLength": 1000},
    "authorization_required": {"const": true},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/archive_item"}},
    "exclusions": {"type": "array", "const": ["purge", "overwrite", "links", "external paths", "active references", "protected material"]},
    "rollback": {"type": "string", "minLength": 16},
    "restore": {"type": "string", "minLength": 16}
  },
  "$defs": {
    "archive_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "destination", "kind", "classification", "classification_reason", "confidence", "classification_evidence", "references_checked", "retained_canonical", "supersedes", "restore_consequence", "entries"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "destination": {"type": "string", "minLength": 1},
        "kind": {"enum": ["file", "directory"]},
        "classification": {"const": "archive_candidate"},
        "classification_reason": {"type": "string", "minLength": 8},
        "confidence": {"enum": ["low", "medium", "high"]},
        "classification_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "references_checked": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "retained_canonical": {"type": ["string", "null"], "minLength": 1},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "restore_consequence": {"type": "string", "minLength": 16},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_entry"}}
      }
    },
    "file_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
