{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-agent-runtime.local/schemas/harness-v3.json",
  "title": "Generic Agent Runtime manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "display_name",
    "version",
    "released",
    "runtime_language",
    "source_baseline",
    "adapters",
    "contract_versions",
    "policy_versions",
    "instruction_budget",
    "core_skills",
    "specialist_skills",
    "schemas",
    "security_policy",
    "distribution",
    "execution_limits",
    "archive_limits"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "const": "generic-agent-runtime" },
    "display_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "released": { "type": "string", "format": "date" },
    "runtime_language": { "type": "string", "minLength": 1 },
    "source_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^agent-runtime-v[0-9]+\\.[0-9]+\\.zip$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*\\.md$" }
    },
    "contract_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "gate_result", "bridge_event"],
      "properties": {
        "task": { "const": "1.0" },
        "gate_result": { "const": "1.0" },
        "bridge_event": { "const": "2.0" }
      }
    },
    "policy_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "authorized_target", "security_test_plan", "ui_review", "architecture_policy", "project_template", "source_of_truth", "release_documentation", "automation_decision", "adoption_plan"],
      "properties": {
        "security": { "const": "1.0" },
        "authorized_target": { "const": "1.0" },
        "security_test_plan": { "const": "1.0" },
        "ui_review": { "const": "1.0" },
        "architecture_policy": { "const": "1.0" },
        "project_template": { "const": "1.0" },
        "source_of_truth": { "const": "1.0" },
        "release_documentation": { "const": "1.0" },
        "automation_decision": { "const": "1.0" },
        "adoption_plan": { "const": "1.0" }
      }
    },
    "instruction_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents_md_max_bytes", "agents_md_max_lines"],
      "properties": {
        "agents_md_max_bytes": { "type": "integer", "minimum": 4096, "maximum": 32768 },
        "agents_md_max_lines": { "type": "integer", "minimum": 50, "maximum": 500 }
      }
    },
    "core_skills": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "specialist_skills": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "gate_result",
        "bridge_event",
        "security_policy",
        "authorized_target",
        "security_test_plan",
        "ui_review",
        "architecture_policy",
        "project_template",
        "automation_decision",
        "adoption_plan"
      ],
      "properties": {
        "task": { "const": "schemas/task-contract.schema.json" },
        "gate_result": { "const": "schemas/gate-result.schema.json" },
        "bridge_event": { "const": "schemas/bridge-event.schema.json" },
        "security_policy": { "const": "schemas/security-policy.schema.json" },
        "authorized_target": { "const": "schemas/authorized-target.schema.json" },
        "security_test_plan": { "const": "schemas/security-test-plan.schema.json" },
        "ui_review": { "const": "schemas/ui-review.schema.json" },
        "architecture_policy": { "const": "schemas/architecture-policy.schema.json" },
        "project_template": { "const": "schemas/project-template.schema.json" },
        "automation_decision": { "const": "schemas/automation-decision.schema.json" },
        "adoption_plan": { "const": "schemas/adoption-plan.schema.json" }
      }
    },
    "security_policy": { "const": "security-policy.json" },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive",
        "manifest",
        "scaffold_root",
        "project_template_root",
        "exclude_maintainer_tasks",
        "empty_bridge",
        "maintainer_marker",
        "adoption_policy"
      ],
      "properties": {
        "archive": { "type": "string", "pattern": "^agent-runtime-v[0-9]+\\.[0-9]+\\.zip$" },
        "manifest": { "const": "MANIFEST.sha256" },
        "scaffold_root": { "const": "scaffold" },
        "project_template_root": { "const": "project-templates/python-react-hybrid" },
        "exclude_maintainer_tasks": { "const": true },
        "empty_bridge": { "const": true },
        "maintainer_marker": { "const": ".harness-source" },
        "adoption_policy": { "const": "adoption-policy.json" }
      }
    },
    "execution_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_command_timeout_seconds",
        "runtime_command_timeout_seconds",
        "kill_grace_seconds",
        "failure_tail_lines",
        "max_output_buffer_bytes",
        "validation_attempts"
      ],
      "properties": {
        "default_command_timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "runtime_command_timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 600 },
        "kill_grace_seconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "failure_tail_lines": { "type": "integer", "minimum": 20, "maximum": 500 },
        "max_output_buffer_bytes": { "type": "integer", "minimum": 4096, "maximum": 16777216 },
        "validation_attempts": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "archive_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_entries",
        "max_name_length",
        "max_member_uncompressed_bytes",
        "max_total_uncompressed_bytes",
        "max_compression_ratio"
      ],
      "properties": {
        "max_entries": { "type": "integer", "minimum": 32, "maximum": 10000 },
        "max_name_length": { "type": "integer", "minimum": 64, "maximum": 1024 },
        "max_member_uncompressed_bytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 },
        "max_total_uncompressed_bytes": { "type": "integer", "minimum": 8388608, "maximum": 4294967296 },
        "max_compression_ratio": { "type": "integer", "minimum": 10, "maximum": 1000 }
      }
    }
  }
}
