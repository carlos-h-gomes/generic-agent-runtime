{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/archive-manifest-v1.json",
  "title": "Harness archive manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "archive_id", "status", "created_at", "workspace_root", "workspace_fingerprint", "plan_id", "plan_sha256", "archive_root", "owner", "reason", "authorization_ref", "moves", "verification", "restore"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "archive_id": {"type": "string", "pattern": "^arc-[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,47}$"},
    "status": {"enum": ["applying", "archived", "rolled_back", "blocked_recovery", "restored"]},
    "created_at": {"type": "string", "format": "date-time"},
    "workspace_root": {"type": "string", "minLength": 1},
    "workspace_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_id": {"type": "string", "pattern": "^plan-[a-f0-9]{16}$"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "archive_root": {"type": "string", "minLength": 9},
    "owner": {"type": "string", "minLength": 2, "maxLength": 200},
    "reason": {"type": "string", "minLength": 8},
    "authorization_ref": {"type": "string", "minLength": 3},
    "moves": {"type": "array", "minItems": 1, "items": {"$ref": "archive-plan.schema.json#/$defs/archive_item"}},
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["status", "problems"],
      "properties": {
        "status": {"enum": ["pending", "passed", "failed"]},
        "verified_at": {"type": "string", "format": "date-time"},
        "problems": {"type": "array", "items": {"type": "string"}}
      }
    },
    "restore": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "restored", "blocked_recovery"]},
        "overwrite": {"const": false},
        "restored_at": {"type": "string", "format": "date-time"},
        "authorization_ref": {"type": "string", "minLength": 3},
        "last_error": {"type": "string", "minLength": 1},
        "problems": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
