{
  "$schema": "../../schemas/project-template.schema.json",
  "schema_version": "1.0",
  "template_id": "python-react-hybrid",
  "profile": "python-react-hybrid",
  "minimum_directories": [
    "backend",
    "backend/app",
    "backend/app/controllers",
    "backend/app/services",
    "backend/app/models",
    "backend/app/schemas",
    "backend/app/repositories",
    "backend/tests",
    "frontend",
    "frontend/src",
    "frontend/src/api",
    "frontend/src/assets",
    "frontend/src/components",
    "frontend/src/components/layout",
    "frontend/src/components/ui",
    "frontend/src/context",
    "frontend/src/data",
    "frontend/src/hooks",
    "frontend/src/pages",
    "frontend/src/services",
    "frontend/src/utils",
    "frontend/tests",
    "docs",
    "docs/ai",
    "docs/architecture"
  ],
  "files": [
    "SOURCE-OF-TRUTH.md",
    "backend/README.md",
    "backend/app/__init__.py",
    "backend/app/main.py",
    "backend/app/controllers/__init__.py",
    "backend/app/services/__init__.py",
    "backend/app/models/__init__.py",
    "backend/app/schemas/__init__.py",
    "backend/app/repositories/__init__.py",
    "backend/tests/__init__.py",
    "frontend/README.md",
    "frontend/src/App.tsx",
    "frontend/src/main.tsx",
    "frontend/src/api/.gitkeep",
    "frontend/src/assets/.gitkeep",
    "frontend/src/components/layout/AppLayout.tsx",
    "frontend/src/components/ui/.gitkeep",
    "frontend/src/context/.gitkeep",
    "frontend/src/data/.gitkeep",
    "frontend/src/hooks/.gitkeep",
    "frontend/src/pages/.gitkeep",
    "frontend/src/services/.gitkeep",
    "frontend/src/utils/.gitkeep",
    "frontend/tests/.gitkeep",
    "docs/ai/architecture-policy.json",
    "docs/architecture/DIRECTORY-MAP.md",
    "docs/TECHNICAL-DOCUMENTATION.md",
    "docs/USER-MANUAL.md"
  ],
  "extension_policy": {
    "allow_additional_directories": true,
    "authority": "docs/ai/conventions.md"
  },
  "collision_policy": {
    "preflight": true,
    "overwrite": false,
    "differing_existing_file": "skip_with_explicit_merge"
  }
}
