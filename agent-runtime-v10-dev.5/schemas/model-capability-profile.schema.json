{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/model-capability-profile-v1.json",
  "title": "Harness optional model capability profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "provider", "model", "purpose", "status", "checked_at", "access", "capabilities", "budgets", "fallback", "sources"],
  "properties": {
    "$schema": {"type": "string"}, "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1}, "status": {"enum": ["optional", "deprecated", "unavailable"]},
    "checked_at": {"type": "string", "format": "date"},
    "access": {"type": "object", "additionalProperties": false, "required": ["separate_provisioning", "detect_before_use", "never_infer"], "properties": {"separate_provisioning": {"type": "boolean"}, "detect_before_use": {"const": true}, "never_infer": {"const": true}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["reasoning_efforts", "tools", "structured_outputs", "constraints"], "properties": {"reasoning_efforts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "structured_outputs": {"type": "boolean"}, "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["tokens", "latency", "tool_steps", "retries", "cost"], "properties": {"tokens": {"type": "string", "minLength": 1}, "latency": {"type": "string", "minLength": 1}, "tool_steps": {"type": "string", "minLength": 1}, "retries": {"type": "string", "minLength": 1}, "cost": {"type": "string", "minLength": 1}}},
    "fallback": {"type": "object", "additionalProperties": false, "required": ["behavior", "approved_profile_required"], "properties": {"behavior": {"type": "string", "minLength": 1}, "approved_profile_required": {"const": true}}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["url", "as_of"], "properties": {"url": {"type": "string", "format": "uri"}, "as_of": {"type": "string", "format": "date"}}}}
  }
}
