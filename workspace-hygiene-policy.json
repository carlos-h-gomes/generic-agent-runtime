{
  "$schema": "schemas/workspace-hygiene-policy.schema.json",
  "schema_version": "1.0",
  "archive_directory": "_archives",
  "index_file": "index.jsonl",
  "manifest_file": "archive-manifest.json",
  "journal_file": "move-journal.jsonl",
  "payload_directory": "content",
  "default_mode": "plan_only",
  "follow_links": false,
  "automatic_purge": false,
  "classification": {
    "states": ["active", "reference", "archive_candidate", "archived", "protected", "purge_eligible"],
    "positive_candidate_signals": ["task_done", "explicitly_superseded", "exact_duplicate", "reproducible_generated_artifact", "owner_instruction"],
    "age_alone_is_sufficient": false,
    "unknown_state": "protected"
  },
  "protected_exact": [
    ".git",
    ".harness",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "SOURCE-OF-TRUTH.md",
    "LICENSE",
    "harness.json",
    "MANIFEST.sha256",
    "SBOM.cdx.json",
    "PROVENANCE.intoto.json",
    "security-policy.json",
    "workspace-hygiene-policy.json",
    "docs/ai/architecture-policy.json",
    "docs/ai/quality-gates.md",
    "docs/ai/decision-log.md",
    "docs/ai/risks.md",
    "docs/ai/commands.md"
  ],
  "protected_prefixes": [".agents/", ".github/", "app/", "infra/", "infrastructure/", "lib/", "migrations/", "packages/", "project-templates/", "prompt-templates/", "schemas/", "scripts/", "security/", "src/", "test/", "tests/"],
  "protected_names": ["AGENTS.md", "SOURCE-OF-TRUTH.md", "LICENSE", "MANIFEST.sha256", "SBOM.cdx.json", "PROVENANCE.intoto.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock", "poetry.lock", "Pipfile.lock", "Cargo.lock", "go.sum"],
  "protected_suffixes": [".lock", ".tar", ".tgz", ".zip"],
  "sensitive_names": ["credentials.json", "secrets.json", "auth.json", "kubeconfig"],
  "sensitive_suffixes": [".db", ".env", ".har", ".key", ".kdbx", ".log", ".ovpn", ".p12", ".pcap", ".pem", ".pfx", ".sqlite", ".tfstate"],
  "reference_extensions": [".json", ".md", ".py", ".js", ".jsx", ".ts", ".tsx", ".toml", ".yaml", ".yml"],
  "max_reference_file_bytes": 1048576,
  "max_hash_file_bytes": 8388608,
  "max_index_file_bytes": 8388608,
  "active_discovery_excludes": ["**/_archives/**/content/**"],
  "restore_overwrite": false
}
