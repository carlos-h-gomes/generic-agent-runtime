{
  "$schema": "schemas/security-policy.schema.json",
  "schema_version": "1.0",
  "checked_at": "2026-07-30",
  "expires_at": "2026-08-29",
  "sources": [
    {
      "title": "Next.js July 2026 Security Release",
      "url": "https://nextjs.org/blog/july-2026-security-release",
      "as_of": "2026-07-30"
    },
    {
      "title": "Next.js Support Policy",
      "url": "https://nextjs.org/support-policy",
      "as_of": "2026-07-30"
    },
    {
      "title": "Node.js Releases",
      "url": "https://nodejs.org/en/about/previous-releases",
      "as_of": "2026-07-30"
    },
    {
      "title": "CPython Supported Versions",
      "url": "https://devguide.python.org/versions/",
      "as_of": "2026-08-03"
    },
    {
      "title": "React Versions",
      "url": "https://react.dev/versions",
      "as_of": "2026-08-03"
    },
    {
      "title": "Vite Releases",
      "url": "https://vite.dev/releases",
      "as_of": "2026-08-03"
    },
    {
      "title": "OWASP ASVS",
      "url": "https://owasp.org/www-project-application-security-verification-standard/",
      "as_of": "2026-07-30"
    }
  ],
  "execution": {
    "require_explicit_project_trust": true,
    "inherit_environment": false,
    "allowed_environment": [
      "APPDATA",
      "CI",
      "ComSpec",
      "HOME",
      "LANG",
      "LC_ALL",
      "LOCALAPPDATA",
      "NODE_ENV",
      "PATH",
      "PATHEXT",
      "PROGRAMDATA",
      "SystemRoot",
      "TEMP",
      "TERM",
      "TMP",
      "TMPDIR",
      "USERPROFILE",
      "WINDIR",
      "XDG_CACHE_HOME"
    ],
    "secret_name_pattern": "(?i)(secret|token|password|passwd|credential|private[_-]?key|api[_-]?key|access[_-]?key|session|cookie|authorization)"
  },
  "runtimes": {
    "node": {
      "allowed_lts_majors": [22, 24],
      "require_deployment_pin": true,
      "source": "https://nodejs.org/en/about/previous-releases"
    },
    "python": {
      "default_bugfix_minors": ["3.14", "3.13"],
      "supported_security_minors": ["3.12", "3.11", "3.10"],
      "require_deployment_pin": true,
      "source": "https://devguide.python.org/versions/"
    }
  },
  "frameworks": {
    "next": {
      "block_prerelease": true,
      "supported": [
        {
          "major": 15,
          "minimum": "15.5.21",
          "support": "maintenance_lts"
        },
        {
          "major": 16,
          "minimum": "16.2.11",
          "support": "active_lts"
        }
      ],
      "source": "https://nextjs.org/blog/july-2026-security-release"
    },
    "react": {
      "stable_major": 19,
      "stable_minor": "19.2",
      "block_prerelease": true,
      "source": "https://react.dev/versions"
    },
    "vite": {
      "default_line": "8.1",
      "supported_lines": ["8.1", "8.0", "7.3", "6.4"],
      "block_prerelease": true,
      "source": "https://vite.dev/releases"
    }
  },
  "release": {
    "block_high_or_critical": true,
    "require_lockfile": true,
    "required_web_artifacts": [
      "docs/ai/threat-model.md",
      "docs/ai/incident-response.md",
      "docs/ai/ui-review.json",
      "docs/ai/architecture-policy.json",
      "SOURCE-OF-TRUTH.md",
      "docs/TECHNICAL-DOCUMENTATION.md",
      "docs/USER-MANUAL.md"
    ],
    "required_scanner_classes": [
      "dependency",
      "secret",
      "sast"
    ]
  }
}
